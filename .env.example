# =====================================================================
# 康伴 3D 数字人康养陪伴系统 - 环境配置示例
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，严禁提交真实密钥。
# 所有 CHANGE_ME / 空值为安全占位，不代表已接入对应服务。
# =====================================================================

# ---------------------- Day1 基础配置（启动必填） ----------------------
APP_NAME=康伴 3D 数字人康养陪伴系统
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO
# 本地 PostgreSQL 异步 URL；Alembic 迁移也从该配置读取。仅限本地开发库。
DATABASE_URL=postgresql+asyncpg://kangban_dev:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5433/kangban_dev
# pytest 专用独立测试库（kangban_test）；库不存在时 conftest 报错并提示创建命令
DATABASE_URL_TEST=postgresql+asyncpg://kangban_dev:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5433/kangban_test
# 后续 Redis 连接配置；Day1 不建立会话业务
REDIS_URL=redis://127.0.0.1:6379/0
SQL_ECHO=false

# ---------------------- 后续能力预留配置（Optional，空值不影响 Day1 启动） ----------------------

# System 2 大模型（DeepSeek/Qwen 兼容 API；最终厂商由 POC 确定，不猜真实 Base URL）
LLM_PROVIDER=CHANGE_ME
LLM_API_KEY=
LLM_BASE_URL=CHANGE_ME
LLM_MODEL=CHANGE_ME
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

# Embedding（模型与维度由 POC 确定，Day1 不预设）
EMBEDDING_PROVIDER=CHANGE_ME
EMBEDDING_MODEL=CHANGE_ME
EMBEDDING_BASE_URL=CHANGE_ME
EMBEDDING_API_KEY=

# System One（Chinese-Jev/Laya 本地推理，选型由 POC 确定）
SYSTEM_ONE_PROVIDER=CHANGE_ME
SYSTEM_ONE_MODEL_PATH=CHANGE_ME
SYSTEM_ONE_CONFIDENCE_THRESHOLD=0.85
SYSTEM_ONE_TIMEOUT_MS=200

# ASR（普通话/方言流式转写；目标方言由 POC 确定）
ASR_PROVIDER=CHANGE_ME
ASR_API_KEY=
ASR_BASE_URL=CHANGE_ME
ASR_MODEL=CHANGE_ME
ASR_DIALECT=CHANGE_ME

# TTS（普通话/方言流式朗读与 viseme）
TTS_PROVIDER=CHANGE_ME
TTS_API_KEY=
TTS_BASE_URL=CHANGE_ME
TTS_VOICE_ID=CHANGE_ME
TTS_DIALECT=CHANGE_ME

# 方言规范化（仅按需启用；阈值经评测确定）
DIALECT_NORMALIZATION_ENABLED=false
DIALECT_NORMALIZATION_MODEL=CHANGE_ME
DIALECT_MIN_CONFIDENCE=

# 声纹（CAMPPlus 本地推理；向量加密方案待 POC）
VOICEPRINT_MODEL_PATH=CHANGE_ME
# Day3：CAMPPlus 余弦相似度阈值（POC-04 提前执行基线 0.55）
VOICEPRINT_THRESHOLD=0.55
VOICEPRINT_ENCRYPTION_KEY=

# ---------------------- Day3 实时语音（全部 Optional，空值不影响启动） ----------------------
# FunASR 本地 Docker WSS（compose.funasr.yaml，端口 10096）
FUNASR_URL=wss://127.0.0.1:10096
# 自签名证书跳过校验（仅本地开发）
FUNASR_INSECURE=1
# Edge-TTS 朗读音色（适老偏温和女声）
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
# 声纹验证通过后临时 Token 有效期（秒，仅内存）
VOICEPRINT_TOKEN_TTL=300
# sherpa-onnx 本地模型目录（models/，不入 Git）
SHERPA_MODEL_DIR=models/
# 登录页「老人生物识别进入」演示开关（1=开，0=关；指纹点击即进属教学演示后门，答辩可置 0）
BIOMETRIC_DEMO_ENABLED=1
# STUN/TURN JSON 数组（跨机器 POC 时填教师拓扑；空=本地 host 候选）
# 示例：[{"urls":"turn:x.x.x.x:3478","username":"u","credential":"p"}]
RTC_ICE_SERVERS=
# 注：Day1 预留的 WEBRTC_STUN/TURN_* 与本项择一使用，Day3 实时模块读取 RTC_ICE_SERVERS

# WebRTC（Day1 预留字段，正式部署时与 RTC_ICE_SERVERS 择一使用）
WEBRTC_STUN_SERVERS=
WEBRTC_TURN_SERVERS=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# JWT / 设备 Token（Day2 启用必填；人 JWT 与设备 Token 分开校验、互不通用）
# JWT_SECRET_KEY 本地生成：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
DEVICE_TOKEN_EXPIRE_DAYS=90
DEVICE_REGISTRATION_TOKEN_HOURS=24

# 数据保留（原始音频最长保留时长，小时）
AUDIO_RETENTION_HOURS=72

# Langfuse（Day10 接入观测时启用）
LANGFUSE_HOST=CHANGE_ME
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
